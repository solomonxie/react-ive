# From Auth0 dashboard → Applications → APIs → your API → "Identifier"
AUTH0_AUDIENCE=https://api.hello-auth0.local
# Your tenant domain, e.g. dev-abc123.us.auth0.com (no https://)
AUTH0_DOMAIN=
# Lesson 05: Applications → your Machine to Machine app → Settings
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# Lesson 06: Applications → your Single Page app → Settings
AUTH0_SPA_CLIENT_ID=
